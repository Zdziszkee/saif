{
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		},
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun-types"],

		/* Bundler mode */
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"erasableSyntaxOnly": true,
		"resolveJsonModule": true,
		"noEmit": true,

		/* Strictness: every strict flag and every lint-grade check enabled */
		"strict": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"exactOptionalPropertyTypes": true,
		"strictBuiltinIteratorReturn": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedSideEffectImports": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"forceConsistentCasingInFileNames": true,

		/* Dependency d.ts files reference uninstalled optional peers (pg, mysql2,
		   bun, @babel/*, ...), so lib checking is out of our control. All
		   application code is fully checked regardless. */
		"skipLibCheck": true
	}
}
