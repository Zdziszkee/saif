[
	{
		"id": "inj-ignore-previous",
		"name": "Ignore-previous-instructions injection",
		"description": "Classic prompt-injection payload instructing the model to drop prior instructions",
		"pattern": "ignore\\s+(?:all\\s+)?(?:previous|prior|above|earlier)\\s+(?:instructions|prompts|messages|rules)",
		"kind": "prompt_injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "inj-system-marker",
		"name": "Faked system chat marker",
		"description": "Faked chat-template system markers used to smuggle instructions",
		"pattern": "<\\|im_start\\|>\\s*system|<\\|system\\|>|\\[SYSTEM\\]\\s*:",
		"kind": "prompt_injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "inj-role-hijack",
		"name": "Role-hijack persona override",
		"description": "Role-hijack payload re-assigning the assistant an unrestricted persona",
		"pattern": "(?:you\\s+are\\s+now|act\\s+as\\s+(?:if\\s+you\\s+are|an?\\s+unrestricted))\\s+(?:an?\\s+)?(?:unrestricted|jailbroken|uncensored|developer[- ]mode|evil\\s+assistant)",
		"kind": "prompt_injection",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "jail-dan",
		"name": "DAN jailbreak template",
		"description": "DAN-style jailbreak template ('do anything now')",
		"pattern": "\\bDAN\\s+mode\\b|do\\s+anything\\s+now",
		"kind": "jailbreak",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "jail-bypass-filters",
		"name": "Safety-filter bypass request",
		"description": "Explicit request to bypass safety or content filters",
		"pattern": "bypass\\s+(?:your|the|all|any)\\s+(?:safety|content|security)\\s+(?:filters?|policies|restrictions|guardrails?)",
		"kind": "jailbreak",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "jail-disable-safety",
		"name": "Safety-control disable request",
		"description": "Explicit request to disable or remove safety controls",
		"pattern": "(?:disable|turn\\s+off|remove)\\s+(?:your|the|all|any)\\s+(?:safety|content|security)\\s+(?:filters?|policies|checks|guardrails?|restrictions)",
		"kind": "jailbreak",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-system-prompt",
		"name": "System-prompt retrieval",
		"description": "System-prompt retrieval attempt asking the model to expose hidden instructions",
		"pattern": "(?:reveal|show|print|output|repeat|leak)\\s+(?:me\\s+)?(?:your|the|all)\\s+(?:system|initial|hidden|original)\\s+(?:prompt|instructions?|messages?)",
		"kind": "data_exfiltration",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-instructions-query",
		"name": "Hidden-instructions query",
		"description": "Direct query for the model's system prompt or hidden instructions",
		"pattern": "what\\s+(?:are|is)\\s+your\\s+(?:system|initial|hidden)\\s+(?:prompt|instructions?)",
		"kind": "data_exfiltration",
		"severity": "medium",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-repeat-above",
		"name": "Context replay request",
		"description": "Context-retrieval attempt asking to replay prior hidden content",
		"pattern": "(?:repeat|print|output|send)\\s+(?:everything|all\\s+(?:of\\s+)?(?:the\\s+)?(?:text|content|instructions?|messages?))\\s+(?:above|before|previously)",
		"kind": "data_exfiltration",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-secrets-transfer",
		"name": "Secrets transfer to external endpoint",
		"description": "Exfiltration attempt sending data, files, or secrets to an external endpoint",
		"pattern": "(?:send|upload|post|exfiltrate|forward|leak)\\s+(?:all\\s+|the\\s+|any\\s+)?(?:data|files?|secrets?|credentials?|env(?:ironment)?\\s*vars?|keys?)\\s+(?:to|into|over)\\s+(?:https?://|webhook|pastebin|telegram|[a-z0-9.-]+\\.[a-z]{2,})",
		"kind": "data_exfiltration",
		"severity": "critical",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-secret-file",
		"name": "Credential-file retrieval",
		"description": "Retrieval attempt reading credential files or system identity files",
		"pattern": "(?:cat|read|open|print|type|show)\\s+(?:the\\s+)?(?:\\.env\\b|\\.aws/credentials|id_rsa\\b|/etc/(?:passwd|shadow)|\\.ssh/)",
		"kind": "data_exfiltration",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "exfil-path-traversal",
		"name": "Directory traversal",
		"description": "Directory-traversal sequence aimed at reaching data outside the sandbox",
		"pattern": "(?:\\.\\./){2,}",
		"kind": "data_exfiltration",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "tool-shell-pipe",
		"name": "Tool-call shell pipe",
		"description": "Tool-call argument piping content into a shell interpreter",
		"pattern": "\"(?:cmd|command|shell|script|args?)\"\\s*:\\s*\"[^\"]*\\|\\s*(?:ba|z)?sh\\b",
		"kind": "tool_abuse",
		"severity": "critical",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "tool-delete-recursive",
		"name": "Tool-call recursive delete",
		"description": "Tool-call argument invoking recursive forced deletion",
		"pattern": "\"(?:cmd|command|shell|script)\"\\s*:\\s*\"[^\"]*\\brm\\s+-rf?\\s",
		"kind": "tool_abuse",
		"severity": "critical",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "tool-download-execute",
		"name": "Download-and-execute chain",
		"description": "Download-and-execute chain (curl/wget piped into a shell)",
		"pattern": "(?:curl|wget)\\s+[^\\s\"']+\\s*\\|\\s*(?:ba|z)?sh\\b",
		"kind": "tool_abuse",
		"severity": "critical",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "tool-encoded-powershell",
		"name": "Encoded PowerShell payload",
		"description": "PowerShell invocation with an encoded command payload",
		"pattern": "powershell[^\\n\"]*-e(?:nc(?:odedCommand)?)?\\s+[A-Za-z0-9+/=]{20,}",
		"kind": "tool_abuse",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "tool-read-sensitive-path",
		"name": "Tool-call sensitive path read",
		"description": "Tool-call file argument pointing at credential or out-of-scope paths",
		"pattern": "\"(?:path|file|filename|target)\"\\s*:\\s*\"[^\"]*(?:\\.env\\b|\\.\\./|/etc/|\\.ssh/)",
		"kind": "tool_abuse",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "deser-pickle",
		"name": "Unsafe pickle deserialization",
		"description": "Unsafe pickle deserialization marker",
		"pattern": "pickle\\.(?:loads?|Unpickler)\\s*\\(|__reduce__",
		"kind": "unsafe_deserialization",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "deser-yaml-unsafe",
		"name": "Unsafe YAML deserialization",
		"description": "Unsafe YAML deserialization marker",
		"pattern": "yaml\\.(?:unsafe_load|full_load)\\s*\\(|yaml\\.load\\s*\\([^)]*Loader\\s*=\\s*(?:yaml\\.)?Loader",
		"kind": "unsafe_deserialization",
		"severity": "high",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "deser-eval-payload",
		"name": "eval() over decoded payload",
		"description": "eval() over decoded base64 payloads",
		"pattern": "\\beval\\s*\\(\\s*(?:atob|base64_decode|Buffer\\.from)",
		"kind": "unsafe_deserialization",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "supply-model-resolve-url",
		"name": "Model artifact from resolve URL",
		"description": "Model artifact fetched from a model-repo resolve URL (supply-chain vector)",
		"pattern": "https?://(?:huggingface\\.co|hf\\.co)/\\S+/resolve/\\S+\\.(?:py|bin|pt|onnx|safetensors|exe|sh)\\b",
		"kind": "supply_chain",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "supply-torch-hub",
		"name": "torch.hub.load from arbitrary repo",
		"description": "torch.hub.load from an arbitrary repository (model supply-chain vector)",
		"pattern": "torch\\.hub\\.load\\s*\\(\\s*['\"][^'\"]+['\"]",
		"kind": "supply_chain",
		"severity": "high",
		"source": "mitre-atlas",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "supply-pip-untrusted-index",
		"name": "pip install from untrusted index",
		"description": "pip install from an index other than the official PyPI mirrors",
		"pattern": "pip3?\\s+install\\s+[^\\n]*--index-url\\s+https?://(?!pypi\\.org|files\\.pythonhosted\\.org)[^\\s]+",
		"kind": "supply_chain",
		"severity": "medium",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	},
	{
		"id": "supply-pretrained-from-url",
		"name": "from_pretrained remote URL",
		"description": "from_pretrained() loading weights straight from a remote URL",
		"pattern": "from_pretrained\\s*\\(\\s*['\"]https?://",
		"kind": "supply_chain",
		"severity": "medium",
		"source": "owasp-llm-top10",
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z"
	}
]
