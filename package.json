{
  "name": "saif",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test --path-ignore-patterns tests/integration",
    "test:watch": "bun test --watch",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "tsc --noEmit && biome check .",
    "data:names": "bun scripts/build-name-data.ts",
    "fixtures:env": "bun scripts/build-fixture-env.ts",
    "test:integration": "SEMANTIC_LIVE=1 bun test tests/integration",
    "semantic:probe": "bun scripts/semantic-smoke.ts",
    "intent": "node node_modules/@tanstack/intent/dist/cli.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "test:integration": "bun test tests/integration"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "0.64.0",
    "@tanstack/ai-anthropic": "0.19.4",
    "@tanstack/ai-client": "0.36.1",
    "@tanstack/ai-gemini": "0.34.2",
    "@tanstack/ai-mcp": "0.7.0",
    "@tanstack/ai-ollama": "0.11.12",
    "@tanstack/ai-openai": "0.26.0",
    "@tanstack/ai-react": "0.29.4",
    "@tanstack/ai-typesafe": "0.1.7",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/store": "0.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "^14.17.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "0.5.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/intent": "^0.5.2",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
