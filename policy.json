{
  "consumers": {
    "alice": {
      "profile": "standard"
    },
    "analyst": {
      "profile": "permissive"
    },
    "deploy-bot": {
      "overrides": {
        "enabledControls": {
          "detection": true,
          "semantic": false,
          "signatures": true
        }
      },
      "profile": "strict"
    }
  },
  "controls": {
    "allowlist": {
      "models": [
        {
          "endpoint": "https://api.example.com/v1",
          "name": "primary"
        },
        {
          "name": "local-small"
        }
      ]
    },
    "budget": {
      "overBudgetVerdict": "block",
      "rules": [
        {
          "key": "alice",
          "modelScope": "*",
          "period": "day",
          "tokens": 250000
        },
        {
          "costUsd": 20,
          "key": "alice",
          "modelScope": "*",
          "period": "month"
        },
        {
          "computeTimeMs": 600000,
          "key": "deploy-bot",
          "modelScope": "*",
          "period": "day"
        },
        {
          "key": "analyst",
          "modelScope": "primary",
          "period": "day",
          "requests": 500
        }
      ]
    },
    "detection": {
      "builtins": {
        "encodingRescan": true,
        "entropyScan": true,
        "genericCredentials": true,
        "pii": true,
        "providerSecrets": true
      },
      "defaultActions": {
        "custom": "redact",
        "pii": "redact",
        "secret": "block",
        "suspect": "flag"
      },
      "rules": [
        {
          "action": "flag",
          "directions": [
            "outbound"
          ],
          "id": "internal-codename",
          "kind": "custom",
          "pattern": "\\bCONFIDENTIAL\\b"
        },
        {
          "action": "redact",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "employee-id",
          "kind": "pii",
          "pattern": "\\bEMP-[0-9]{6}\\b"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-inj-ignore-previous",
          "kind": "owasp:LLM01:prompt-injection",
          "pattern": "ignore\\s+(?:all\\s+)?(?:previous|prior|above|earlier)\\s+(?:instructions|prompts|messages|rules)"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-jail-dan",
          "kind": "owasp:LLM01:jailbreak",
          "pattern": "\\bDAN\\s+mode\\b|do\\s+anything\\s+now"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-jail-bypass",
          "kind": "owasp:LLM01:jailbreak",
          "pattern": "bypass\\s+(?:your|the|all|any)\\s+(?:safety|content|security)\\s+(?:filters?|policies|restrictions|guardrails?)"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-exfil-system-prompt",
          "kind": "owasp:LLM07:system-prompt-leakage",
          "pattern": "(?:reveal|show|print|output|repeat|leak)\\s+(?:me\\s+)?(?:your|the|all)\\s+(?:system|initial|hidden|original)\\s+(?:prompt|instructions?|messages?)"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-exfil-secret-file",
          "kind": "owasp:LLM02:sensitive-information-disclosure",
          "pattern": "(?:cat|read|open|print|type|show)\\s+(?:the\\s+)?(?:\\.env\\b|\\.aws/credentials|id_rsa\\b|/etc/(?:passwd|shadow)|\\.ssh/)"
        },
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "owasp-tool-shell-pipe",
          "kind": "owasp:LLM06:excessive-agency",
          "pattern": "\"(?:cmd|command|shell|script|args?)\"\\s*:\\s*\"[^\"]*\\|\\s*(?:ba|z)?sh\\b"
        }
      ]
    },
    "enabled": true,
    "redaction": {
      "enabled": true
    },
    "shape": {
      "maxContentBytes": 65536
    },
    "signatures": {
      "enabled": true,
      "perSignatureActions": {
        "atlas-sig-001": "redact"
      },
      "severityActions": {
        "critical": "block",
        "high": "block",
        "low": "flag",
        "medium": "redact"
      },
      "suspect": {
        "action": "escalate",
        "threshold": 0.8
      }
    }
  },
  "defaults": {
    "failureVerdict": "escalate",
    "profile": "standard"
  },
  "profiles": {
    "permissive": {
      "enabledControls": {
        "detection": true,
        "semantic": true,
        "signatures": true
      },
      "thresholds": {
        "detection": {
          "inbound": {
            "block": 0.95,
            "escalate": 0.3,
            "redact": 0.7
          },
          "outbound": {
            "block": 0.95,
            "escalate": 0.3,
            "redact": 0.7
          }
        },
        "semantic": {
          "inbound": {
            "block": 0.95,
            "escalate": 0.3,
            "redact": 0.7
          },
          "outbound": {
            "block": 0.95,
            "escalate": 0.3,
            "redact": 0.7
          }
        },
        "signatures": {
          "inbound": {
            "block": 0.9,
            "escalate": 0.3,
            "redact": 0.6
          },
          "outbound": {
            "block": 0.9,
            "escalate": 0.3,
            "redact": 0.6
          }
        }
      }
    },
    "standard": {
      "enabledControls": {
        "detection": true,
        "semantic": true,
        "signatures": true
      },
      "thresholds": {
        "detection": {
          "inbound": {
            "block": 0.85,
            "escalate": 0.4,
            "redact": 0.6
          },
          "outbound": {
            "block": 0.85,
            "escalate": 0.4,
            "redact": 0.6
          }
        },
        "semantic": {
          "inbound": {
            "block": 0.85,
            "escalate": 0.4,
            "redact": 0.6
          },
          "outbound": {
            "block": 0.85,
            "escalate": 0.4,
            "redact": 0.6
          }
        },
        "signatures": {
          "inbound": {
            "block": 0.8,
            "escalate": 0.4,
            "redact": 0.55
          },
          "outbound": {
            "block": 0.8,
            "escalate": 0.4,
            "redact": 0.55
          }
        }
      }
    },
    "strict": {
      "enabledControls": {
        "detection": true,
        "semantic": true,
        "signatures": true
      },
      "thresholds": {
        "detection": {
          "inbound": {
            "block": 0.7,
            "escalate": 0.5,
            "redact": 0.5
          },
          "outbound": {
            "block": 0.7,
            "escalate": 0.5,
            "redact": 0.5
          }
        },
        "semantic": {
          "inbound": {
            "block": 0.7,
            "escalate": 0.5,
            "redact": 0.5
          },
          "outbound": {
            "block": 0.7,
            "escalate": 0.5,
            "redact": 0.5
          }
        },
        "signatures": {
          "inbound": {
            "block": 0.65,
            "escalate": 0.5,
            "redact": 0.45
          },
          "outbound": {
            "block": 0.65,
            "escalate": 0.5,
            "redact": 0.45
          }
        }
      }
    }
  },
  "version": "1"
}
