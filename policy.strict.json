{
  "consumers": {
    "alice": {
      "profile": "strict"
    },
    "deploy-bot": {
      "overrides": {
        "thresholds": {
          "detection": {
            "inbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            },
            "outbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            }
          },
          "semantic": {
            "inbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            },
            "outbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            }
          },
          "signatures": {
            "inbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            },
            "outbound": {
              "block": 0.5,
              "escalate": 0.4,
              "redact": 0.3
            }
          }
        }
      },
      "profile": "strict"
    }
  },
  "controls": {
    "allowlist": {
      "models": [
        {
          "endpoint": "https://api.example.com/v1",
          "name": "primary"
        }
      ]
    },
    "budget": {
      "overBudgetVerdict": "block",
      "rules": [
        {
          "key": "alice",
          "modelScope": "*",
          "period": "day",
          "tokens": 100000
        },
        {
          "costUsd": 5,
          "key": "alice",
          "modelScope": "*",
          "period": "month"
        },
        {
          "computeTimeMs": 120000,
          "key": "deploy-bot",
          "modelScope": "*",
          "period": "day"
        },
        {
          "key": "deploy-bot",
          "modelScope": "primary",
          "period": "day",
          "requests": 100
        }
      ]
    },
    "detection": {
      "builtins": {
        "encodingRescan": true,
        "entropyScan": true,
        "genericCredentials": true,
        "pii": true,
        "providerSecrets": true
      },
      "defaultActions": {
        "custom": "block",
        "pii": "redact",
        "secret": "block",
        "suspect": "block"
      },
      "rules": [
        {
          "action": "block",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "internal-codename",
          "kind": "custom",
          "pattern": "\\bCONFIDENTIAL\\b"
        },
        {
          "action": "redact",
          "directions": [
            "inbound",
            "outbound"
          ],
          "id": "employee-id",
          "kind": "pii",
          "pattern": "\\bEMP-[0-9]{6}\\b"
        }
      ]
    },
    "enabled": true,
    "redaction": {
      "enabled": true
    },
    "shape": {
      "maxContentBytes": 32768
    },
    "signatures": {
      "enabled": true,
      "perSignatureActions": {
        "atlas-sig-001": "block"
      },
      "severityActions": {
        "critical": "block",
        "high": "block",
        "low": "redact",
        "medium": "block"
      },
      "suspect": {
        "action": "escalate",
        "threshold": 0.6
      }
    }
  },
  "defaults": {
    "failureVerdict": "block",
    "profile": "strict"
  },
  "profiles": {
    "permissive": {
      "enabledControls": {
        "detection": true,
        "semantic": true,
        "signatures": true
      },
      "thresholds": {
        "detection": {
          "inbound": {
            "block": 0.85,
            "escalate": 0.4,
            "redact": 0.6
          },
