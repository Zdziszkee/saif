		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "deser-php-unserialize",
		"name": "PHP unserialize marker",
		"description": "PHP object injection entry point and its Node port",
		"pattern": "\\bunserialize\\s*\\(|node-serialize\\.unserialize",
