[
	{
		"id": "code-child-process",
		"name": "Node child-process spawn",
		"description": "Node child-process execution or require marker in tool content",
		"pattern": "child_process\\.(?:exec|execSync|spawn)\\s*\\(|require\\(['\"]child_process['\"]\\)",
		"kind": "malicious-code",
		"severity": "high",
		"source": "mitre-atlas",
		"references": ["https://atlas.mitre.org/"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "code-eval-input",
		"name": "Evaluator over attacker input",
		"description": "Dynamic evaluation applied to prompt or request-derived input",
		"pattern": "\\beval\\s*\\([^)]*(?:prompt|user_input|userInput|request\\.form)",
		"kind": "malicious-code",
		"severity": "high",
		"source": "mitre-atlas",
		"references": ["https://atlas.mitre.org/"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "code-os-system",
		"name": "OS command execution call",
		"description": "Direct OS command execution from hosted code markers",
		"pattern": "\\bos\\.system\\s*\\(|subprocess\\.(?:run|call|Popen)\\s*\\(",
		"kind": "malicious-code",
		"severity": "high",
		"source": "mitre-atlas",
		"references": ["https://atlas.mitre.org/"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "deser-java-native",
		"name": "Java native deserialization",
		"description": "Java native deserialization markers across common libraries",
		"pattern": "ObjectInputStream|\\.readObject\\s*\\(\\s*\\)|XStream\\.fromXML\\s*\\(",
		"kind": "unsafe-deserialization",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://owasp.org/www-project-top-10-for-large-language-model-applications/"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "deser-marshal-shelve",
		"name": "Marshal or shelve deserialization",
		"description": "Python marshal loads or shelve open markers",
		"pattern": "marshal\\.loads\\s*\\(|shelve\\.open\\s*\\(",
		"kind": "unsafe-deserialization",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://owasp.org/www-project-top-10-for-large-language-model-applications/"],
