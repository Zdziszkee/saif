	{
		"id": "exfil-secret-file",
		"name": "Credential-file read request",
		"description": "Prompt-injection attempt to make the model read credential files or system identity files",
		"pattern": "(?:cat|read|open|print|type|show)\\s+(?:the\\s+)?(?:\\.env\\b|\\.aws/credentials|id_rsa\\b|/etc/(?:passwd|shadow)|\\.ssh/)",
		"kind": "injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://owasp.org/www-project-top-10-for-large-language-model-applications/"],
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "exfil-system-prompt",
		"name": "System-prompt retrieval",
		"description": "Prompt-injection attempt to make the model reveal its hidden system instructions",
		"pattern": "(?:reveal|show|print|output|repeat|leak)\\s+(?:me\\s+)?(?:your|the|all)\\s+(?:system|initial|hidden|original)\\s+(?:prompt|instructions?|messages?)",
		"kind": "injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://owasp.org/www-project-top-10-for-large-language-model-applications/"],
		"addedAt": "2026-10-03T00:00:00.000Z",
		"updatedAt": "2026-10-03T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "inj-above-override",
		"name": "Above-instructions override",
		"description": "Order to disregard the instructions above and act instead",
		"pattern": "ignore\\s+(?:the\\s+)?above\\s+and\\s+do|disregard\\s+(?:all\\s+)?(?:prior|previous)\\s+rules\\s+and",
		"kind": "injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://cheatsheetseries.owasp.org/cheatsheets/LLM_Prompt_Injection_Prevention_Cheat_Sheet.html"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "inj-base64-directive",
		"name": "Base64 decode-and-follow",
		"description": "Directive to decode a base64 payload and then obey it",
		"pattern": "decode\\s+(?:this\\s+)?base64\\s+(?:string\\s+)?and\\s+(?:follow|execute|run)\\s+it",
		"kind": "injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://cheatsheetseries.owasp.org/cheatsheets/LLM_Prompt_Injection_Prevention_Cheat_Sheet.html"],
		"addedAt": "2026-10-04T00:00:00.000Z",
		"updatedAt": "2026-10-04T00:00:00.000Z",
		"enabled": true
	},
	{
		"id": "inj-delimiter-escape",
		"name": "Chat-template delimiter escape",
		"description": "Closing delimiter smuggling a new privileged turn",
		"pattern": "</\\s*(?:system|instructions|prompt)\\s*>|\\[\\s*/\\s*(?:SYSTEM|INSTRUCTIONS)\\s*\\]",
		"kind": "injection",
		"severity": "high",
		"source": "owasp-llm-top10",
		"references": ["https://cheatsheetseries.owasp.org/cheatsheets/LLM_Prompt_Injection_Prevention_Cheat_Sheet.html"],
